VITE_API_URL=http://localhost:8080

# Cấu hình đăng nhập nhanh Google (Lấy từ console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=

# Cấu hình đăng nhập nhanh Facebook (Lấy từ developers.facebook.com)
VITE_FACEBOOK_APP_ID=

# Facebook Client Token — bắt buộc cho đăng nhập Facebook trên app Android
VITE_FACEBOOK_CLIENT_TOKEN=

# IP LAN máy tính (điện thoại thật). Có thể đổi trong app: màn hình đăng nhập → "Máy chủ kết nối".
VITE_LAN_IP=
