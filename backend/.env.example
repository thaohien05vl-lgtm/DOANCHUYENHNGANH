# SQL Server. Nếu SQL Server chạy trên máy tính này và instance đã được đặt TCP Port 1433:
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=FinoraDb;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=THAY_BANG_MAT_KHAU_SQL_SERVER_CUA_BAN

# Chuỗi bí mật JWT tối thiểu 32 ký tự. Hãy thay riêng trước khi triển khai thật.
JWT_SECRET=Finora-Local-Development-Secret-Key-Change-Before-Deploy-2026
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Tuỳ chọn: chỉ cần khi sử dụng chức năng quét hoá đơn bằng Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Đăng nhập Google/Facebook: backend kiểm tra token có đúng ứng dụng của bạn (chống giả mạo token từ app khác).
# GOOGLE_CLIENT_IDS = OAuth Client ID loại "Web application" (cùng giá trị VITE_GOOGLE_CLIENT_ID ở frontend).
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
